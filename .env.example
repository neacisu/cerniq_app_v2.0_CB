# Copiați în .env local (nu comitați secrete). Valorile reale vin din OpenBao / CMDB (stacks-02).
# Documentație medii: docs/enterprise/env-matrix-secrets.md

# API (apps/api) — bind dev (plajă v2 plan: 25010 — vezi deploy-topology-v2.md)
# HOST=0.0.0.0
# PORT=25010

# Redis shared — orchestrator DNAT (stacks-04) sau VIP hz.247 (stacks-05 B1)
# Din orchestrator: redis://10.0.0.2:6379/0
# Din rețea vSwitch cu ACL: redis://10.0.1.10:6379/0

# Temporal cluster
# TEMPORAL_ADDRESS=temporal.example:7233

# Postgres central lxc-postgres-main (stacks-05 H8 — IP auditat)
# DATABASE_URL=postgresql://user:pass@10.0.1.107:5432/cerniq_v2

# Web Next — proxy API intern (apps/web/.env.example)
# CERNIQ_API_INTERNAL_URL=http://127.0.0.1:25010

# OTel trace → Collector pe orchestrator (dovadă: /opt/observability — OTLP HTTP :4318)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_SERVICE_NAME=cerniq-api

# Nx Cloud (opțional)
# NX_CLOUD_ACCESS_TOKEN=
