# Copiați în .env local (nu comitați secrete). Valorile reale vin din OpenBao / CMDB (stacks-02).

# API (apps/api) — bind dev
# HOST=0.0.0.0
# PORT=25010

# Redis shared (fără container dedicat în proiect)
# REDIS_URL=redis://10.0.1.10:6379/0

# Temporal cluster
# TEMPORAL_ADDRESS=temporal.example:7233

# Postgres central
# DATABASE_URL=postgresql://user:pass@lxc-postgres-main:5432/cerniq_v2

# Nx Cloud (opțional)
# NX_CLOUD_ACCESS_TOKEN=
