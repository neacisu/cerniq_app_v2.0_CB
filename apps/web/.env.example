# Copiază în .env.local (nu comita). Valori reale: OpenBao / CMDB (stacks-02).
# Next.js încarcă .env.local pentru dev.

# URL API Fastify pentru Route Handlers (server-side proxy SSE) — rețea Traefik / internal DNS.
# CERNIQ_API_INTERNAL_URL=http://127.0.0.1:25010

# Redis (doar dacă serverul Next apelează direct — altfel gestionat la API)
# REDIS_URL=redis://10.0.1.10:6379/0

# OTel RUM browser: 1 = activ (doar dacă endpoint-urile sunt configurate în cod)
# NEXT_PUBLIC_OTEL_RUM=0

# Subset capitole în nav (dev): `home,brain,ingest` — aliniat permisiuni `chapter:*` din API; gol = toate.
# NEXT_PUBLIC_CERNIQ_DEV_CHAPTERS=
