{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["jest", "node"],
    "outDir": "./out-tsc/jest"
  },
  "include": [
    "next-env.d.ts",
    "jest-axe.d.ts",
    "jest.setup.ts",
    "specs/**/*.d.ts",
    "jest.config.ts",
    "specs/**/*.ts",
    "specs/**/*.tsx",
    "app/api/**/*.ts",
    "lib/**/*.spec.ts",
    "lib/**/*.spec.tsx",
    "lib/**/*.test.ts",
    "lib/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".next", "out-tsc", "dist"]
}
