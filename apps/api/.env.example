# Copiază în .env local (nu commita). Secretele reale vin din OpenBao / GitHub Secrets (stacks-02).
HOST=0.0.0.0
PORT=25010
LOG_LEVEL=info

# JWT HS256 — minim 32 caractere. În producție: doar din OpenBao.
JWT_SECRET=change-me-minimum-32-characters-long-secret-key

# Doar dev: permite /v1/me cu doar X-Tenant-Id (fără Bearer). NU folosi în producție.
# AUTH_DEV_ALLOW_TENANT_HEADER=1
