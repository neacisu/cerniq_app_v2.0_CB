# Copiază în .env local (nu commita). Secretele reale vin din OpenBao / GitHub Secrets (stacks-02).
HOST=0.0.0.0
PORT=25010
LOG_LEVEL=info

# JWT HS256 — minim 32 caractere. În producție: doar din OpenBao.
JWT_SECRET=change-me-minimum-32-characters-long-secret-key

# Doar dev: permite /v1/me cu doar X-Tenant-Id (fără Bearer). NU folosi în producție.
# AUTH_DEV_ALLOW_TENANT_HEADER=1

# Redis shared (webhooks idempotency + cote LLM) — orchestrator 10.0.0.2:6379 sau VIP 10.0.1.10:6379
# REDIS_URL=redis://10.0.0.2:6379/0

# Webhook inbound — secret din OpenBao; fără secret, ruta răspunde 503
# WEBHOOK_INBOUND_SECRET=

# OTel trace OTLP/HTTP — pe orchestrator, Collector expune 127.0.0.1:4318 (vezi docs/enterprise/env-matrix-secrets.md)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_SERVICE_NAME=cerniq-api
# OTEL_SDK_DISABLED=true

# LLM — patru URL-uri (stacks-05 VIP 49xxx); în dev poți folosi LLM_DEV_MOCK_BASE
# LLM_GUARD_BASE_URL=
# LLM_FAST_BASE_URL=
# LLM_REASONING_BASE_URL=
# LLM_EMBEDDINGS_BASE_URL=
